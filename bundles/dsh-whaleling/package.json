{
  "name": "dsh-whaleling",
  "version": "0.1.0",
  "description": "Bridge plugin that exposes live DeepSeek Harness session state to the whaleling floating widget.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-bundle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rUrU516/dsh-whaleling.git",
    "directory": "bundles/dsh-whaleling"
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
